# AlphaFold 3 v3.0.4 — built on the same host architecture it runs on
# (verified on ARM64 / NVIDIA Grace Hopper; also builds on x86_64 for A100).

Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.9.24
Stage: uv

Bootstrap: docker
From: nvidia/cuda:12.6.3-base-ubuntu24.04
Stage: final


# -----------------------------------------------------------------------------
# Metadata
# -----------------------------------------------------------------------------

%labels
    AlphaFoldVersion v3.0.4


# -----------------------------------------------------------------------------
# Host-side setup
#
# Runs on the host before files are copied into the container rootfs.
# Extracts git provenance from the host submodule checkout.
# -----------------------------------------------------------------------------

%setup
    mkdir -p "${APPTAINER_ROOTFS}/opt"
    git -C alphafold3 describe --tags --always --dirty \
        > "${APPTAINER_ROOTFS}/opt/alphafold3_version" 2>/dev/null \
        || echo "v3.0.4" > "${APPTAINER_ROOTFS}/opt/alphafold3_version"
    git -C alphafold3 rev-parse HEAD \
        > "${APPTAINER_ROOTFS}/opt/alphafold3_commit" 2>/dev/null \
        || echo "85c4d20505fd5cef05eac22b534d4e793971ae69" > "${APPTAINER_ROOTFS}/opt/alphafold3_commit"


# -----------------------------------------------------------------------------
# Copy uv and the checked-out AlphaFold source into the image
# -----------------------------------------------------------------------------

%files from uv
    /uv  /bin/uv
    /uvx /bin/uvx

%files
    alphafold3 /app/alphafold


# -----------------------------------------------------------------------------
# Runtime environment
#
# Variables defined here are set whenever the finished container is run.
# -----------------------------------------------------------------------------

%environment
    # Ask uv to compile Python source to bytecode. This matches the upstream
    # AF3 container configuration and avoids repeated bytecode compilation
    # during later runs.
    export UV_COMPILE_BYTECODE=1

    # Tell uv where the Python virtual environment lives inside the image.
    # Keeping this at a fixed path means all AF3 Python dependencies are
    # contained in /alphafold3_venv rather than installed into system Python.
    export UV_PROJECT_ENVIRONMENT=/alphafold3_venv

    # Add the custom HMMER installation and AF3 virtual environment to PATH.
    # This makes commands such as jackhmmer and Python available directly.
    export PATH="/hmmer/bin:/alphafold3_venv/bin:$PATH"

    # Disable Triton GEMM generation in XLA. This matches the standard AF3
    # container configuration and is kept fixed for baseline runs.
    export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false"

    # JAX/XLA normally preallocates a large GPU-memory pool when it first
    # accesses the GPU. This reduces allocation overhead and fragmentation,
    # but means reported GPU memory use is not the same as AF3's instantaneous
    # memory requirement.
    #
    # We retain the upstream behaviour for baseline runs and can override it
    # at runtime for dedicated memory-profiling experiments.
    export XLA_PYTHON_CLIENT_PREALLOCATE=true

    # Fraction of GPU memory JAX may reserve when preallocation is enabled.
    # AF3 uses 0.95 by default.
    export XLA_CLIENT_MEM_FRACTION=0.95


# -----------------------------------------------------------------------------
# Build the software environment
# -----------------------------------------------------------------------------

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    # BMRC's outbound proxy rejects plain HTTP Ubuntu mirrors. NVIDIA's base
    # image still configures those mirrors with HTTP, so upgrade them to HTTPS.
    sed -i \
        -e 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g' \
        -e 's|http://security.ubuntu.com|https://security.ubuntu.com|g' \
        /etc/apt/sources.list /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null \
        || true

    apt-get update --quiet
    apt-get install --yes --quiet \
        python3.12 \
        python3.12-dev \
        git \
        wget \
        gcc \
        g++ \
        make \
        zlib1g-dev \
        zstd \
        patch \
        ca-certificates

    # %environment affects the finished container, so variables required
    # during the build must also be set explicitly here.
    export UV_COMPILE_BYTECODE=1
    export UV_PROJECT_ENVIRONMENT=/alphafold3_venv
    export PATH="/hmmer/bin:/alphafold3_venv/bin:$PATH"

    # Record the architecture this image was built on, since the same
    # definition is used for both ARM64 (Grace Hopper) and x86_64 (A100) hosts.
    uname -m > /opt/alphafold3_arch


    # -------------------------------------------------------------------------
    # Build the patched HMMER 3.4 used by AlphaFold
    # -------------------------------------------------------------------------

    mkdir -p /hmmer_build /hmmer
    cd /hmmer_build

    wget http://eddylab.org/software/hmmer/hmmer-3.4.tar.gz

    echo "ca70d94fd0cf271bd7063423aabb116d42de533117343a9b27a65c17ff06fbf3 hmmer-3.4.tar.gz" \
        | sha256sum --check

    tar zxf hmmer-3.4.tar.gz
    rm hmmer-3.4.tar.gz

    patch -p0 < /app/alphafold/docker/jackhmmer_seq_limit.patch

    cd hmmer-3.4
    ./configure --prefix=/hmmer
    make -j
    make install

    cd easel
    make install

    # Leave the HMMER build tree before deleting it.
    cd /
    rm -rf /hmmer_build


    # -------------------------------------------------------------------------
    # Install the locked AlphaFold Python environment
    # -------------------------------------------------------------------------

    uv venv "$UV_PROJECT_ENVIRONMENT"

    cd /app/alphafold

    # --frozen uses the checked-in uv.lock exactly, while --no-editable
    # installs AF3 as a fixed package suitable for an immutable container.
    UV_LINK_MODE=copy \
        uv sync --frozen --all-groups --no-editable

    # build_data was installed into the virtual environment by uv sync above.
    # Run it directly so uv does not try to resynchronise or rebuild AF3.
    build_data


    # -------------------------------------------------------------------------
    # Cleanup
    # -------------------------------------------------------------------------

    rm -rf /app/alphafold/.git
    rm -rf /var/lib/apt/lists/*


# -----------------------------------------------------------------------------
# Default command
#
# Arguments supplied to `apptainer run` are passed directly to AlphaFold.
# The virtual environment is already installed and does not need uv to
# synchronise it again at runtime.
# -----------------------------------------------------------------------------

%runscript
    cd /app/alphafold
    exec /alphafold3_venv/bin/python3 run_alphafold.py "$@"


# -----------------------------------------------------------------------------
# Basic build-time sanity checks
# -----------------------------------------------------------------------------

%test
    /alphafold3_venv/bin/python3 --version
    /hmmer/bin/jackhmmer -h >/dev/null
    /alphafold3_venv/bin/python3 -c 'import alphafold3'
